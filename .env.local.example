# ==============================================================
# VARIAVEIS DE AMBIENTE - Agent IT Dashboard
# ==============================================================
# Copie este arquivo para ".env.local" (desenvolvimento local) e
# preencha com valores reais. NUNCA commite ".env.local" no Git -
# ele ja esta no .gitignore por padrao do Next.js.
#
# Em producao (Vercel), estas mesmas variaveis sao configuradas em:
#   Vercel Dashboard -> Project -> Settings -> Environment Variables
# NUNCA no codigo, nunca no repositorio.
# ==============================================================

# --------------------------------------------------------------
# SUPABASE - Project Settings -> API
# --------------------------------------------------------------
# URL do projeto (a mesma usada no Agent IT / Edge Functions)
SUPABASE_URL=https://sluhfuoazyykrhhgestg.supabase.co

# Service Role Key - NUNCA a anon key aqui. Esta chave ignora Row
# Level Security e so deve existir no backend (nunca no navegador,
# nunca com prefixo NEXT_PUBLIC_). E o que permite a dashboard ler
# a tabela que esta travada para todo mundo mais.
SUPABASE_SERVICE_ROLE_KEY=COLE_A_SERVICE_ROLE_KEY_AQUI

# --------------------------------------------------------------
# AZURE AD (Microsoft Entra ID) - App Registration
# --------------------------------------------------------------
# portal.azure.com -> Microsoft Entra ID -> App registrations ->
# Agent IT Dashboard -> Overview (Client ID, Tenant ID) e
# Certificates & secrets (Client Secret)
AZURE_AD_CLIENT_ID=COLE_O_APPLICATION_CLIENT_ID_AQUI
AZURE_AD_CLIENT_SECRET=COLE_O_CLIENT_SECRET_AQUI
AZURE_AD_TENANT_ID=COLE_O_DIRECTORY_TENANT_ID_AQUI

# --------------------------------------------------------------
# NEXTAUTH
# --------------------------------------------------------------
# URL publica da dashboard. Em desenvolvimento local, deixe como
# esta. Em producao no Vercel, troque para a URL real (ex.:
# https://agent-it-dashboard.vercel.app) - e essa mesma URL + 
# "/api/auth/callback/azure-ad" que voce cadastra como Redirect URI
# no Azure App Registration.
NEXTAUTH_URL=http://localhost:3000

# Chave secreta usada pelo NextAuth para assinar sessoes/cookies.
# Gere uma nova com: openssl rand -base64 32
NEXTAUTH_SECRET=GERE_UM_VALOR_ALEATORIO_AQUI
